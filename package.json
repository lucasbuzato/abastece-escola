{
  "name": "abastece-escola",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "node server/local.mjs",
    "dev:web": "npm run dev --workspace @abastece/web",
    "mobile": "npm run start --workspace @abastece/mobile",
    "build": "npm run build --workspace @abastece/web && node scripts/build-worker.mjs",
    "build:mobile": "npm run export --workspace @abastece/mobile",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:all": "npm run build:mobile && npm run build",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "esbuild": "^0.28.2",
    "@types/node": "^24.0.0"
  }
}
