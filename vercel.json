{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": ".vercel-output",
  "framework": null,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://abastece-escola.toughazure1.chatgpt.site/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/app(?:/.*)?",
      "dest": "/app/index.html"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
