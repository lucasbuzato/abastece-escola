{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": ".vercel-output",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://abastece-escola.toughazure1.chatgpt.site/api/:path*"
    },
    {
      "source": "/coordenacao",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    }
  ]
}